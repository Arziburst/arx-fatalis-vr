{
  "_comment": "Arx Fatalis VR worker safety settings, from core/settings.example.windows.json (swarm baseline). Passed to every worker by core/scripts/start-worker.ps1 -Safety. Local additions: the hook also sees Edit/Write (owner-copy protection via COORD_PROTECTED_ROOT); workers merge their own PRs with gh (PROJECT.md), so only the MCP merge tool is denied. Absolute paths: this machine's owner copy.",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "crossSessionInbound": "accept",
  "worktree": {
    "bgIsolation": "none"
  },
  "env": {
    "COORD_PROTECTED_ROOT": "E:\\dev\\arx-fatalis-vr"
  },
  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Bash(git push --force origin main)",
      "Bash(git push -f origin main)",
      "Bash(git push --force origin master)",
      "Bash(git push -f origin master)",
      "Bash(git push --force-with-lease origin main)",
      "Bash(git push --force-with-lease origin master)",
      "Bash(git push --mirror*)",
      "Bash(git push --all*)",
      "Bash(gh repo delete *)",
      "PowerShell(git push origin main)",
      "PowerShell(git push origin main *)",
      "PowerShell(git push origin master)",
      "PowerShell(git push origin master *)",
      "PowerShell(git push --force origin main)",
      "PowerShell(git push -f origin main)",
      "PowerShell(git push --force origin master)",
      "PowerShell(git push -f origin master)",
      "PowerShell(git push --force-with-lease origin main)",
      "PowerShell(git push --force-with-lease origin master)",
      "PowerShell(git push --mirror*)",
      "PowerShell(git push --all*)",
      "PowerShell(gh repo delete *)",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__merge_pull_request"
    ],
    "allow": [
      "PowerShell(Select-String *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(git log *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File E:\\dev\\arx-fatalis-vr\\coordinator\\core\\scripts\\hooks\\safety-guard.ps1 -SelfTest",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File E:\\dev\\arx-fatalis-vr\\coordinator\\core\\scripts\\hooks\\safety-guard.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
