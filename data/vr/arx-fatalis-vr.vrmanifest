{
	"source": "builtin",
	"applications": [
		{
			"app_key": "arxfatalisvr.app.arx",
			"launch_type": "binary",
			"binary_path_windows": "@BINARY_PATH_WINDOWS@",
			"arguments": "@ARGUMENTS@",
			"image_path": "@IMAGE_PATH@",
			"strings": {
				"en_us": {
					"name": "Arx Fatalis VR",
					"description": "VR port of Arx Fatalis, built on the Arx Libertatis engine."
				}
			}
		}
	]
}
