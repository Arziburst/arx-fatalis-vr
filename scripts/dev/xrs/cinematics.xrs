vr-input tap right.b
@until state eq GAMEPLAY 30s
@frames 5

# Every image of every cinematic was uploaded inside its buffer: no upload found a pixel-store state that would
# have read past it, nothing else went wrong
@assert events.byName."cinematic.start" eq 19
@assert events.byName."cinematic.end" eq 19
@nolog GLTexture:.*Texture upload found GL_UNPACK
@assert errors eq 0
