# The whole first run of a player in the headset (#394): one plain player launch (@player, no --dev-launch) on the
# simulated headset walks the path from the publisher logos to the first steps in the prison - the two logos
# skipped with A and the trigger, the level 10 intro on the VR screen skipped with A during its scripted scene (before
# introduction.cin plays), the main menu with no leaked click, Options with one setting changed by pointer and back,
# New game, the character creation by pointer clicks, the prison (area 1) and a walk with the left stick. The parts
# have their own, faster sequences (first-run-intro, first-run-menu, first-run-chargen); this one keeps the seams
# between them from breaking.
#   .\scripts\dev\xrs-run.ps1 first-run
@sim idle
@player

# The logos: FISHTANK, then ARKANE; A and the trigger skip them
@until state eq LOGO 90s
@until vr.panel.mode eq screen 10s
vr-input tap right.a
@log GameEvent:.*startup\.logo name=arkane state=shown 5s
@assert state eq LOGO
vr-input tap right.trigger
@log GameEvent:.*startup\.intro state=start area=10 5s

# The intro's scripted scene, on the screen, in both eyes; A skips it before its cinematic starts
@until state eq INTRO 30s
@until vr.panel.mode eq screen 5s
@wait 3000                                   # the level fades in
@shot intro
@assert vr.sim.shots.intro.left.quadPixels gt 0
@assert vr.sim.shots.intro.right.quadPixels gt 0
@assert vr.sim.shots.intro.left.scene.verdict ne background
@assert vr.sim.shots.intro.right.scene.verdict ne background
@assert state eq INTRO
vr-input tap right.a
@until state eq MENU 15s
@log GameEvent:.*startup\.intro state=end how=skip 5s
@nolog GameEvent:.*cinematic\.start name=introduction\.cin
@assert menuMode eq mainmenu
@assert events.byName."vr.skip" eq 3
@until vr.sessionState eq focused 30s
@until vr.panel.mode eq world 10s
@frames 60
@assert vr.pointer.clicks eq 0               # the skip press reached nothing in the menu

# The main menu, in both eyes
@shot menu
@assert vr.sim.shots.menu.left.quadPixels gt 0
@assert vr.sim.shots.menu.right.quadPixels gt 0
@assert vr.sim.shots.menu.left.scene.verdict ne background
@assert vr.sim.shots.menu.right.scene.verdict ne background

# Options > Interface: the crosshair off by pointer, back twice
@assert settings.crosshair eq true
vr-point right menu options
@frames 5
vr-sim action trigger right 1
@frames 5
vr-sim action trigger right 0
@until menuPage eq options 5s
@frames 90
vr-point right menu system_menus_options_interface
@frames 5
vr-sim action trigger right 1
@frames 5
vr-sim action trigger right 0
@until menuPage eq interface 5s
@frames 30
vr-point right menu system_menus_options_video_crosshair
@frames 5
vr-sim action trigger right 1
@frames 5
vr-sim action trigger right 0
@frames 5
@assert settings.crosshair eq false
vr-point right menu back
@frames 5
vr-sim action trigger right 1
@frames 5
vr-sim action trigger right 0
@until menuPage eq options 5s
@frames 30
vr-point right menu back
@frames 5
vr-sim action trigger right 1
@frames 5
vr-sim action trigger right 0
@until menuPage eq none 5s

# New game: the character creation, the average hero by quick generation, Done
vr-point right menu newquest
@frames 5
vr-sim action trigger right 1
@frames 5
vr-sim action trigger right 0
@until menuMode eq charactercreation 15s
@until vr.panel.menu eq charactercreation 5s
@frames 120                                  # the screen fades in
@assert hero.attributePoints eq 16
vr-point right menu quickgen
@frames 5
vr-sim action trigger right 1
@frames 5
vr-sim action trigger right 0
@frames 5
@assert hero.strength eq 10
@assert hero.attributePoints eq 0
@assert hero.skillPoints eq 0
vr-point right menu done
@frames 5
@assert ui.menuHover eq done
vr-sim action trigger right 1
@frames 5
vr-sim action trigger right 0

# The prison: area 1, playable once its wake-up script frees the controls; the hero is the one made; the left stick walks
@until area eq 1 60s
@until state eq GAMEPLAY 120s
@assert hero.strength eq 10
@assert hero.mind eq 10
@until player.controlsBlocked eq false 90s
@remember z0 player.z
vr-input stick left 0 1
@frames 45
@assert vr.input.walk.walking eq true
vr-input stick left 0 0
@frames 10
@assert player.z gt {z0+50}                  # the prison start faces +z (yaw about 0): the walk goes along it
@assert errors eq 0
