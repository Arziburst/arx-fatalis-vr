# Melee damage from the swing (#465, D-NEW): no charge - a hit's damage fraction (the aim ratio, 1 = the engine's fully
# charged strike) comes from the stroke's size and the speed of the blade's point that touched, the weaker of the two
# deciding: a touch outside a swing, or a stroke below a minimum, deals the minimum 0.1 (vr_melee_noswing=min, the
# default; none: nothing); a big and fast slash or lunge the full damage. The trigger, held long or short, changes
# nothing. Every hit logs melee.hit with aim, speed, size and kind.
#   .\scripts\dev\smoke-test.ps1 -Playground -VrSim idle -Sequence melee-damage
# The sweeps are ramps of the simulated right controller across the goblin (1.5 m, from 0.8 m right to 0.7 m left):
# in 100 frames 1.35 m/s (no swing: a touch), in 42 frames 3.2 m/s at 90 Hz (part of the damage), in 14 frames
# 9.6 m/s (full). Damage itself has the engine's rolls (critical, armour class), so the sequence asserts the aim.
# Swing hits (vr.melee.hits) and touches (vr.melee.touches: once per recovery) are counted apart, relative to a
# remembered count. The goblin is respawned between the groups of hits.
@sim idle
@playground

@until state eq GAMEPLAY 60s
@until vr.sim.timelineFrame ge 270 60s       # 3 s into the level: past its fade-in (TRAPS.md)
@assert player.controlsBlocked eq false
@assert area eq 30
# Free look closes the inventory a --loadlevel start keeps open (TRAPS.md, #394)
freelook on
@until vr.melee.refused ne inventory 5s

# One weapon per run (TRAPS.md): the dagger, recovery 0.6 s after a hit
inventory playeraddfromscene dagger_9001
dagger_9001.equip player
@until vr.melee.recovery.weapon eq dagger 5s
@assert vr.melee.active eq true
@assert vr.weapon.place eq hand
# The provisional defaults, set live: a cfg.ini kept from an earlier build keeps its old values (TRAPS.md); the
# defaults themselves are MeleeSwingTest::testContactAim's
melee noswing min
melee speed 1.5 4.5
melee size 0.1 0.4
melee lunge 0.05 0.25
@frames 2
@assert vr.melee.params.speedMin eq 1.5
@assert vr.melee.params.speedMax eq 4.5
@assert vr.melee.params.sizeMin eq 0.1
@assert vr.melee.params.sizeMax eq 0.4
@assert vr.melee.params.lungeMin eq 0.05
@assert vr.melee.params.lungeMax eq 0.25
@assert vr.melee.params.noSwing eq min

# The dagger level with the goblin's chest, the hand well to the right - moved there slowly - then the peaceful goblin
# 60 units ahead (placed after the hand, which would touch it on the way)
vr-sim @+1-80 hand right pos 0.8 -0.8 -0.35
vr-sim head rot 0 -25 0
@frames 95
playground place 60
@frames 20
@assert playground.npcAlive eq true
@remember npc playground.npc
@assert vr.melee.swings eq 0
@assert vr.melee.hits eq 0
@assert vr.melee.touches eq 0

# 1. A slow touch: the dagger swept through the goblin at 1.35 m/s is no swing - the minimum (a touch, once per
# recovery)
@mark
vr-sim @+1-100 hand right pos -0.7 -0.8 -0.35
@frames 115
@assert vr.melee.swings eq 0
@assert vr.melee.hits eq 0
@assert vr.melee.touches ge 1
@assert vr.melee.last.target eq {npc}
@assert vr.melee.last.swing eq 0
@assert vr.melee.last.aim eq 0.1
@log melee\.hit source=player target=goblin_base_\d+ weapon=\S+ damage=\S+ aim=0\.10 speed=\S+ size=\S+ kind=\S+

# 2. A medium swing back (3.2 m/s): part of the damage
@until vr.melee.recovery.left eq 0 5s
@remember hits vr.melee.hits
@mark
vr-sim @+1-42 hand right pos 0.8 -0.8 -0.35
@until vr.melee.swings ge 1 5s
@until vr.melee.swinging eq false 5s
@frames 20
@assert vr.melee.hits eq {hits+1}
@assert vr.melee.last.swing gt 0
@assert vr.melee.last.aim gt 0.1
@assert vr.melee.last.aim lt 0.95
@assert vr.melee.last.speed gt 1.5
@assert vr.melee.last.speed lt 4.5
@assert vr.melee.last.size gt 0.1
@assert vr.melee.last.kind eq slash
@log melee\.hit source=player target=goblin_base_\d+ .*aim=0\.\d\d speed=[1-4]\.\d\d size=\S+ kind=slash

# 3. A fast big swing (9.6 m/s, from 0.8 m out): the full damage
@until vr.melee.recovery.left eq 0 5s
@remember swings vr.melee.swings
@remember hits vr.melee.hits
@mark
vr-sim @+1-14 hand right pos -0.7 -0.8 -0.35
@until vr.melee.swings ge {swings+1} 5s
@until vr.melee.swinging eq false 5s
@frames 20
@assert vr.melee.hits eq {hits+1}
@assert vr.melee.last.aim ge 0.99
@assert vr.melee.last.size ge 0.4
@assert vr.melee.last.kind eq slash
@log melee\.hit source=player target=goblin_base_\d+ .*aim=1\.00 speed=\S+ size=\S+ kind=slash
@remember full vr.melee.last.aim

# 4. The trigger changes nothing: held 2 s, the same fast swing deals the same; a medium swing with it held still
# deals part of the damage (the old charge made it full); a short press during a fast swing the same as without
playground kill
@until playground.npcAlive eq false 5s
playground pull respawn
@until playground.npcAlive eq true 5s
playground place 60
@mark
vr-sim action trigger right 1
@frames 180
@assert vr.melee.trigger eq true
@until vr.melee.recovery.left eq 0 5s
@remember swings vr.melee.swings
@remember hits vr.melee.hits
vr-sim @+1-14 hand right pos 0.8 -0.8 -0.35
@until vr.melee.swings ge {swings+1} 5s
@until vr.melee.swinging eq false 5s
@frames 20
@assert vr.melee.trigger eq true
@assert vr.melee.hits eq {hits+1}
@assert vr.melee.last.aim eq {full}
@until vr.melee.recovery.left eq 0 5s
@remember swings vr.melee.swings
@remember hits vr.melee.hits
vr-sim @+1-42 hand right pos -0.7 -0.8 -0.35
@until vr.melee.swings ge {swings+1} 5s
@until vr.melee.swinging eq false 5s
@frames 20
@assert vr.melee.hits eq {hits+1}
@assert vr.melee.last.aim gt 0.1
@assert vr.melee.last.aim lt 0.95
vr-sim action trigger right 0
@frames 10
@assert vr.melee.trigger eq false
@until vr.melee.recovery.left eq 0 5s
@remember swings vr.melee.swings
@remember hits vr.melee.hits
vr-sim action trigger right 1; vr-sim @+1-14 hand right pos 0.8 -0.8 -0.35; vr-sim @+5 action trigger right 0
@until vr.melee.swings ge {swings+1} 5s
@until vr.melee.swinging eq false 5s
@frames 20
@assert vr.melee.hits eq {hits+1}
@assert vr.melee.last.aim eq {full}
@nolog melee\.charge

# 5. Either factor alone keeps a swing low (the thresholds set live, then back): a big swing too slow for the speed
# range, and a fast one too small for the size range, both deal the minimum
playground kill
@until playground.npcAlive eq false 5s
playground pull respawn
@until playground.npcAlive eq true 5s
playground place 60
melee speed 5 10
@until vr.melee.params.speedMin eq 5 5s
@until vr.melee.recovery.left eq 0 5s
@remember swings vr.melee.swings
@remember hits vr.melee.hits
vr-sim @+1-42 hand right pos -0.7 -0.8 -0.35
@until vr.melee.swings ge {swings+1} 5s
@until vr.melee.swinging eq false 5s
@frames 20
@assert vr.melee.hits eq {hits+1}
@assert vr.melee.last.swing gt 0
@assert vr.melee.last.size ge 0.4
@assert vr.melee.last.aim eq 0.1
melee speed 1.5 4.5
melee size 2 3
@until vr.melee.params.sizeMin eq 2 5s
@until vr.melee.recovery.left eq 0 5s
@remember swings vr.melee.swings
@remember hits vr.melee.hits
vr-sim @+1-14 hand right pos 0.8 -0.8 -0.35
@until vr.melee.swings ge {swings+1} 5s
@until vr.melee.swinging eq false 5s
@frames 20
@assert vr.melee.hits eq {hits+1}
@assert vr.melee.last.swing gt 0
@assert vr.melee.last.speed gt 4.5
@assert vr.melee.last.aim eq 0.1
melee size 0.1 0.4
@until vr.melee.params.sizeMin eq 0.1 5s

# 6. A fast long lunge along the blade (10 m/s over 0.7 m): the full damage, kind thrust. The hand drawn back and to
# the middle slowly first, clear of the goblin
playground kill
@until playground.npcAlive eq false 5s
playground pull respawn
@until playground.npcAlive eq true 5s
playground place 60
vr-sim @+1-40 hand right pos 0.8 -0.8 0.35; vr-sim @+41-100 hand right pos 0 -0.8 0.35
@frames 115
@until vr.melee.recovery.left eq 0 5s
@remember swings vr.melee.swings
@remember hits vr.melee.hits
@mark
vr-sim @+1-7 hand right pos 0 -0.8 -0.35
@until vr.melee.swings ge {swings+1} 5s
@until vr.melee.swinging eq false 5s
@frames 20
@assert vr.melee.hits ge {hits+1}
@assert vr.melee.last.kind eq thrust
@assert vr.melee.last.aim ge 0.99
@log melee\.hit source=player target=goblin_base_\d+ .*aim=1\.00 speed=\S+ size=\S+ kind=thrust

# 7. vr_melee_noswing=none (set live): the slow touch deals nothing - the dagger drawn out slowly and swept back
melee noswing none
@until vr.melee.params.noSwing eq none 5s
vr-sim @+1-60 hand right pos 0.8 -0.8 -0.35
@frames 75
@remember touches vr.melee.touches
@mark
vr-sim @+1-100 hand right pos -0.7 -0.8 -0.35
@frames 115
@assert vr.melee.touches eq {touches}
@nolog melee\.hit
melee noswing min
@until vr.melee.params.noSwing eq min 5s

@assert errors eq 0
