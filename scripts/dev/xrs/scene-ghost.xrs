# Scene view 'ghost' (#29, SPEC.md): comfort in scripted scenes - T1 Kultar at the bars (camera entities) and T5 (every speak -c mode).
#   .\scripts\dev\xrs-run.ps1 scene-ghost
# Red until #29 is built: the scene command and the status.json scene.* fields are not in the game yet (29.0, SPEC.md).
# Per stretch: the eyes' camera never lower than 1.2 m above the floor, steps < 5 cm, yaw steps < 1 deg, every cut behind a fade,
# no letterbox bars drawn into an eye; the hero is shown in third person, so the IK arms are off.
@sim idle
@save scene-kultar
@args --loadslot 0

# T1: the save is one step before the KULTAR_WAKE zone, facing +z (scripts/dev/test-saves/scenarios.txt)
@until state eq GAMEPLAY 60s
@until vr.sim.timelineFrame ge 270 60s       # past the level's fade-in (TRAPS.md)
@assert player.controlsBlocked eq false
@assert scene.active eq false
@assert scene.shown eq none
scene view ghost
@assert scene.view eq ghost
scene meter reset
@mark
vr-input stick left 0 1
@until scene.active eq true 60s
vr-input stick left 0 0
@log vr\.scene state=start kind=entity view=ghost
@until scene.shown eq ghost 20s
@assert scene.kind eq entity
@assert scene.armsIk eq false
@shot ghost-t1
@assert vr.sim.shots.ghost-t1.left.scene.verdict ne background
@assert vr.sim.shots.ghost-t1.right.scene.verdict ne background
@until scene.active eq false 120s
@log vr\.scene state=end kind=entity
@assert scene.meter.cuts gt 0
@assert scene.meter.sceneFrames gt 0
@assert scene.meter.minAboveFloorM ge 1.2
@assert scene.meter.maxStepCm lt 5
@assert scene.meter.maxYawStepDeg lt 1
@remember cuts1 scene.meter.cuts
@assert scene.meter.fadedCuts eq {cuts1}
@assert scene.meter.letterboxFrames eq 0

# T5: every speak -c mode on Kultar (one stretch, no input)
scene meter reset
# zoom
human_base_0028.speak -c zoom 0 20 0 20 100 100 [kultar_cantgo]
@until scene.kind eq speech 15s
@until scene.shown eq ghost 5s
@assert scene.active eq true
@assert scene.armsIk eq false
@until scene.kind eq none 30s
# keep
human_base_0028.speak -c keep [kultar_cantgo]
@until scene.kind eq speech 15s
@until scene.shown eq ghost 5s
@assert scene.active eq true
@assert scene.armsIk eq false
@until scene.kind eq none 30s
# side
human_base_0028.speak -c side player 5 5 90 90 0 [kultar_cantgo]
@until scene.kind eq speech 15s
@until scene.shown eq ghost 5s
@assert scene.active eq true
@assert scene.armsIk eq false
@until scene.kind eq none 30s
# side_l
human_base_0028.speak -c side_l player 5 5 90 90 0 [kultar_cantgo]
@until scene.kind eq speech 15s
@until scene.shown eq ghost 5s
@assert scene.active eq true
@assert scene.armsIk eq false
@until scene.kind eq none 30s
# side_r
human_base_0028.speak -c side_r player 5 95 400 150 -10 [kultar_cantgo]
@until scene.kind eq speech 15s
@until scene.shown eq ghost 5s
@assert scene.active eq true
@assert scene.armsIk eq false
@until scene.kind eq none 30s
# ccctalker_l
human_base_0028.speak -c ccctalker_l player 90 100 [kultar_cantgo]
@until scene.kind eq speech 15s
@until scene.shown eq ghost 5s
@assert scene.active eq true
@assert scene.armsIk eq false
@until scene.kind eq none 30s
# ccctalker_r
human_base_0028.speak -c ccctalker_r player 80 40 [kultar_cantgo]
@until scene.kind eq speech 15s
@until scene.shown eq ghost 5s
@assert scene.active eq true
@assert scene.armsIk eq false
@until scene.kind eq none 30s
# ccclistener_l
human_base_0028.speak -c ccclistener_l player 50 50 [kultar_cantgo]
@until scene.kind eq speech 15s
@until scene.shown eq ghost 5s
@assert scene.active eq true
@assert scene.armsIk eq false
@until scene.kind eq none 30s
# ccclistener_r
human_base_0028.speak -c ccclistener_r player 40 40 [kultar_cantgo]
@until scene.kind eq speech 15s
@until scene.shown eq ghost 5s
@assert scene.active eq true
@assert scene.armsIk eq false
@until scene.kind eq none 30s
@assert scene.meter.sceneFrames gt 0
@assert scene.meter.minAboveFloorM ge 1.2
@assert scene.meter.maxStepCm lt 5
@assert scene.meter.maxYawStepDeg lt 1
@remember cuts5 scene.meter.cuts
@assert scene.meter.fadedCuts eq {cuts5}
@assert scene.meter.letterboxFrames eq 0
# T2 and the blind guard (the owner, #29): a new game's hero stands off the level for 2 s before the prison intro
# (TRAPS.md); the ghost view stays black while its eye has no floor under it, so no frame of the intro is measured below 1.2 m
menu pause
@until menuMode eq mainmenu 10s
scene meter reset
newgame
@until state eq GAMEPLAY 60s
@until scene.active eq true 60s
@until scene.shown eq ghost 30s
@until player.controlsBlocked eq false 120s
@until scene.active eq false 30s
@assert scene.meter.sceneFrames gt 0
@assert scene.meter.minAboveFloorM ge 1.2
@remember cuts2 scene.meter.cuts
@assert scene.meter.fadedCuts eq {cuts2}
@assert scene.meter.letterboxFrames eq 0
@assert errors eq 0
