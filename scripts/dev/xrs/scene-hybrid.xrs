# Scene view 'hybrid' (#29, 29.2): first person for dialogue, a virtual screen for far camera shots and the hero's scripted body - T2 the prison intro, T1 Kultar, T8 a level 5 vision ball.
#   .\scripts\dev\xrs-run.ps1 scene-hybrid
# Red until #29 is built: the scene command and the status.json scene.* fields are not in the game yet (29.0, SPEC.md).
# One run: the new game's intro (T2), then - the hero put at the scene-kultar save's spot, facing +z - the walk into the Kultar zone (T1),
# then level 5 (T8). Per stretch: minAboveFloorM >= 1.2 and maxStepCm < 5 over the non-screen frames, every cut behind a fade,
# no letterbox bars in an eye.
@sim idle
@args --skiplogo

@until state eq MENU 60s
@until vr.input.controllers eq index 30s
scene view hybrid
@assert scene.view eq hybrid

# T2: the prison intro (camera entities, the hero dragged by goblins - a scripted body): on the screen
scene meter reset
newgame
@until area eq 1 60s
@until state eq GAMEPLAY 30s
@until scene.active eq true 60s
@until scene.shown eq screen 60s
@assert scene.kind eq entity
@wait 2000
@shot hybrid-t2
@assert vr.sim.shots.hybrid-t2.left.quadPixels gt 0
@assert vr.sim.shots.hybrid-t2.right.quadPixels gt 0
@assert vr.sim.shots.hybrid-t2.left.scene.verdict ne background
@assert vr.sim.shots.hybrid-t2.right.scene.verdict ne background
@until player.controlsBlocked eq false 120s
@until scene.active eq false 30s
@assert scene.meter.screenFrames gt 0
@assert scene.meter.sceneFrames gt 0
@assert scene.meter.minAboveFloorM ge 1.2
@assert scene.meter.maxStepCm lt 5
@assert scene.meter.maxYawStepDeg lt 1
@remember cuts2 scene.meter.cuts
@assert scene.meter.fadedCuts eq {cuts2}
@assert scene.meter.letterboxFrames eq 0

# T1: Kultar at the bars - first person (the camera entities show the dialogue near the hero)
# The intro leaves the hero 6 m short of Kultar's trigger (TRAPS.md): to the scene-kultar save's spot first, outside the stretch
@wait 2000
setpos 8700 3105 8660 0
@wait 1000
scene meter reset
@mark
vr-input stick left 0 1
@until scene.active eq true 60s
vr-input stick left 0 0
@log vr\.scene state=start kind=entity view=hybrid shown=first
@until scene.shown eq first 20s
@assert scene.armsIk eq true
@shot hybrid-t1
@assert vr.sim.shots.hybrid-t1.left.scene.verdict ne background
@assert vr.sim.shots.hybrid-t1.right.scene.verdict ne background
@until scene.active eq false 120s
@assert scene.meter.cuts gt 0
@assert scene.meter.sceneFrames gt 0
@assert scene.meter.minAboveFloorM ge 1.2
@assert scene.meter.maxStepCm lt 5
@assert scene.meter.maxYawStepDeg lt 1
@remember cuts1 scene.meter.cuts
@assert scene.meter.fadedCuts eq {cuts1}
@assert scene.meter.letterboxFrames eq 0

# T8: level 5, a vision ball's camera - a shot of a far place: on the screen
loadlevel 5
@until area eq 5 90s
@until state eq GAMEPLAY 60s
@wait 3000
scene meter reset
sendevent cinematic camera_0137 ""
@until scene.active eq true 15s
@until scene.shown eq screen 10s
@assert scene.kind eq entity
@shot hybrid-t8
@assert vr.sim.shots.hybrid-t8.left.quadPixels gt 0
@assert vr.sim.shots.hybrid-t8.right.quadPixels gt 0
@until scene.active eq false 60s
@assert scene.meter.screenFrames gt 0
@assert scene.meter.sceneFrames gt 0
# The whole vision-ball scene is on the screen: no frame puts the eyes' world camera at the scene view, so the
# height has nothing to measure (29.1's -1); steps stay 0 (the lead's test change, coordinator's ruling: the
# height/step asserts apply to frames whose eyes' world camera is the scene view, cuts == fadedCuts over all)
# Every scene frame is on the screen or behind the opening fade (the start cut's fade-out, before the switch to the
# screen: one fade, 0.15 s at 90 Hz plus its 2 black frames) - none shows the world: screenFrames + openingFrames =
# sceneFrames exactly
@assert scene.meter.worldFrames eq 0
@assert scene.meter.openingFrames le 16
@assert scene.meter.minAboveFloorM eq -1
@assert scene.meter.maxStepCm lt 5
@assert scene.meter.maxYawStepDeg lt 1
@remember cuts8 scene.meter.cuts
@assert scene.meter.fadedCuts eq {cuts8}
@assert scene.meter.letterboxFrames eq 0
@assert errors eq 0
