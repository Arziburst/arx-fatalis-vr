# Scene subtitles in VR (#29, 29.3): every voiced line has a subtitle with the speaker, in the three placements, switchable live; T1 and T5.
#   .\scripts\dev\xrs-run.ps1 scene-subtitles
# Red until #29 is built: the scene command and the status.json scene.* fields are not in the game yet (29.0, SPEC.md).
# lines == voicedLines over a stretch; text, speaker and placement of the line; the text in both eye shots (@shot, the pixels are a CI artifact).
@sim idle
@save scene-kultar
@args --loadslot 0

# T1: the save is one step before the KULTAR_WAKE zone, facing +z (scripts/dev/test-saves/scenarios.txt)
@until state eq GAMEPLAY 60s
@until vr.sim.timelineFrame ge 270 60s       # past the level's fade-in (TRAPS.md)
@assert player.controlsBlocked eq false
@assert scene.active eq false
@assert scene.shown eq none
scene view first

# T1: Kultar's scene, three voiced lines, placement above
scene subtitles above
scene meter reset
vr-input stick left 0 1
@until scene.active eq true 60s
vr-input stick left 0 0
@until scene.subtitle.visible eq true 60s
@assert scene.subtitle.placement eq above
@assert scene.subtitle.speaker ne none
@assert scene.subtitle.text ne none
@shot sub-t1
@assert vr.sim.shots.sub-t1.left.scene.verdict ne background
@assert vr.sim.shots.sub-t1.right.scene.verdict ne background
@until scene.active eq false 120s
@assert scene.subtitle.voicedLines ge 3
@remember voiced scene.subtitle.voicedLines
@assert scene.subtitle.lines eq {voiced}

# T5: a voiced speak -c line, placement above
scene subtitles above
@assert scene.subtitle.placement eq above
scene meter reset
human_base_0028.speak -c zoom 0 20 0 20 100 100 [kultar_letmeout]
@until scene.subtitle.visible eq true 15s
@assert scene.subtitle.placement eq above
@assert scene.subtitle.speaker ne none
@assert scene.subtitle.text ne none
@wait 500
@shot sub-above
@assert vr.sim.shots.sub-above.left.scene.verdict ne background
@assert vr.sim.shots.sub-above.right.scene.verdict ne background
@log vr\.scene\.subtitle placement=above speaker=
@until scene.kind eq none 30s
@assert scene.subtitle.voicedLines eq 1
@assert scene.subtitle.lines eq 1

# T5: a voiced speak -c line, placement chest
scene subtitles chest
@assert scene.subtitle.placement eq chest
scene meter reset
human_base_0028.speak -c zoom 0 20 0 20 100 100 [kultar_letmeout]
@until scene.subtitle.visible eq true 15s
@assert scene.subtitle.placement eq chest
@assert scene.subtitle.speaker ne none
@assert scene.subtitle.text ne none
@wait 500
@shot sub-chest
@assert vr.sim.shots.sub-chest.left.scene.verdict ne background
@assert vr.sim.shots.sub-chest.right.scene.verdict ne background
@log vr\.scene\.subtitle placement=chest speaker=
@until scene.kind eq none 30s
@assert scene.subtitle.voicedLines eq 1
@assert scene.subtitle.lines eq 1

# T5: a voiced speak -c line, placement lowerthird
scene subtitles lowerthird
@assert scene.subtitle.placement eq lowerthird
scene meter reset
human_base_0028.speak -c zoom 0 20 0 20 100 100 [kultar_letmeout]
@until scene.subtitle.visible eq true 15s
@assert scene.subtitle.placement eq lowerthird
@assert scene.subtitle.speaker ne none
@assert scene.subtitle.text ne none
@wait 500
@shot sub-lowerthird
@assert vr.sim.shots.sub-lowerthird.left.scene.verdict ne background
@assert vr.sim.shots.sub-lowerthird.right.scene.verdict ne background
@log vr\.scene\.subtitle placement=lowerthird speaker=
@until scene.kind eq none 30s
@assert scene.subtitle.voicedLines eq 1
@assert scene.subtitle.lines eq 1

# T5: every speak -c mode has its subtitle (placement above); each key is a line with a localised text (the
# sample names of variants, kultar_letmeout2 and the like, have none: a variant's text is string<N> in its line)
scene subtitles above
scene meter reset
# zoom
human_base_0028.speak -c zoom 0 20 0 20 100 100 [kultar_encourage2]
@until scene.subtitle.visible eq true 15s
@assert scene.subtitle.placement eq above
@until scene.kind eq none 30s
# keep
human_base_0028.speak -c keep [kultar_encourage]
@until scene.subtitle.visible eq true 15s
@assert scene.subtitle.placement eq above
@until scene.kind eq none 30s
# side
human_base_0028.speak -c side player 5 5 90 90 0 [kultar_cantgo]
@until scene.subtitle.visible eq true 15s
@assert scene.subtitle.placement eq above
@until scene.kind eq none 30s
# side_l
human_base_0028.speak -c side_l player 5 5 90 90 0 [kultar_please]
@until scene.subtitle.visible eq true 15s
@assert scene.subtitle.placement eq above
@until scene.kind eq none 30s
# side_r
human_base_0028.speak -c side_r player 5 95 400 150 -10 [kultar_hey]
@until scene.subtitle.visible eq true 15s
@assert scene.subtitle.placement eq above
@until scene.kind eq none 30s
# ccctalker_l
human_base_0028.speak -c ccctalker_l player 90 100 [kultar_encourage2]
@until scene.subtitle.visible eq true 15s
@assert scene.subtitle.placement eq above
@until scene.kind eq none 30s
# ccctalker_r
human_base_0028.speak -c ccctalker_r player 80 40 [kultar_encourage]
@until scene.subtitle.visible eq true 15s
@assert scene.subtitle.placement eq above
@until scene.kind eq none 30s
# ccclistener_l
human_base_0028.speak -c ccclistener_l player 50 50 [kultar_cantgo]
@until scene.subtitle.visible eq true 15s
@assert scene.subtitle.placement eq above
@until scene.kind eq none 30s
# ccclistener_r
human_base_0028.speak -c ccclistener_r player 40 40 [kultar_please]
@until scene.subtitle.visible eq true 15s
@assert scene.subtitle.placement eq above
@until scene.kind eq none 30s
@assert scene.subtitle.voicedLines eq 9
@assert scene.subtitle.lines eq 9
@assert errors eq 0
