# VR settings, the saved layout (#178): run after vr-remap.xrs - the next start loads the layout remapped there for the
# Index controllers, and "reset to default" restores #35's layout and removes the saved file.
@sim idle
@args --loadlevel 10

@until state eq GAMEPLAY 60s
@until vr.sim.timelineFrame ge 120 60s
@assert vr.input.controllers eq index
@assert vr.input.layoutFile eq vr-controls-index.ini
@assert vr.input.remapped eq true
@assert vr.input.layout.jump eq right.b
@assert vr.input.layout.magic_mode eq left.grip+left.a
@assert vr.input.layout.crouch_toggle eq right.stick_click:long
@assert vr.input.conflicts eq 1

# The page's "reset to default"
@mark
vr-input default
@frames 2
@assert vr.input.remapped eq false
@assert vr.input.layout.jump eq right.a
@assert vr.input.layout.crouch_toggle eq right.stick_down
@assert vr.input.conflicts eq 0
@log GameEvent:\d+\s+vr\.remap event=all binding=default
@assert errors eq 0
