# VR settings in flat mode (#178): the main menu's Options list has "VR" after "Input", and the VR page lists every
# event with its binding. Flat, no headset: run with smoke-test.ps1 -Menu -Sequence vr-settings-flat (not xrs-run.ps1,
# which starts the simulated headset).
@until state eq MENU 60s
@assert menuMode eq mainmenu
@assert vr.enabled eq false

menu options
@until menuPage eq options 10s
@frames 30
@shot options

menu vr
@until menuPage eq vr 10s
@frames 30
@shot vr-flat
@assert vr.input.remapped eq false
@assert vr.input.layout.jump eq right.a
@assert vr.input.conflicts eq 0

menu none
@until menuPage eq none 10s
@assert errors eq 0
