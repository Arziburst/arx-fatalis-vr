# The weapon in the glove, one item of each class (#385.10, research #453 F-487): the playground's weapon table holds
# every weapon of the game; the hero takes one of each class into the right hand and the anchor - where along the
# handle the glove's closed fingers sit - follows the class's row of the anchor table (vr/WeaponGrip.cpp):
#   sword, dagger    the handle's centre                      anchor = 0.5 of vr.weapon.handleLength
#   axe, mace        near the handle's end                    anchor in 0.15 .. 0.25 of it
#   two-handed       a hand-width above the pommel            anchor = vr.weapon.handWidth, at most the handle
# The class is read from the item (dagger and two-handed by its type, axe and club by its weapon material). Each one
# raised before the eyes is captured for the owner (the look of each grip is his: research's first proposal).
#   .\scripts\dev\xrs-run.ps1 weapon-classes
#   .\scripts\dev\smoke-test.ps1 -Playground -VrSim idle -Sequence weapon-classes
@sim idle
@playground

@until state eq GAMEPLAY 60s
@until vr.sim.timelineFrame ge 270 60s       # 3 s into the level: past its fade-in (TRAPS.md)
@assert player.controlsBlocked eq false
@assert area eq 30
arms custom
grip tilt 0
vr-sim hand right pos 0.12 -0.1 -0.35        # the right hand raised before the eyes, the handle up
vr-sim hand right rot 0 90 0
vr-sim head rot 0 -15 0
@frames 20
@assert vr.body.right.posed eq true

# A sword: the handle's centre
inventory playeraddfromscene long_sword_9001
long_sword_9001.equip player
@until vr.weapon.inHand eq true 5s
@frames 15
@assert vr.weapon.item eq long_sword_9001
@assert vr.weapon.frame eq glove
@assert vr.weapon.weaponClass eq sword
@assert vr.weapon.handleLength gt 0
@remember swordHandle vr.weapon.handleLength
@assert vr.weapon.anchor gt {swordHandle*0.49}
@assert vr.weapon.anchor lt {swordHandle*0.51}
@assert vr.weapon.hiltToGrip lt 0.5
@assert vr.weapon.edgeToKnuckles lt 5
@shot sword

# A dagger: the handle's centre
inventory playeraddfromscene dagger_9001
dagger_9001.equip player
@until vr.weapon.item eq dagger_9001 5s
@frames 15
@assert vr.weapon.frame eq glove
@assert vr.weapon.weaponClass eq dagger
@remember daggerHandle vr.weapon.handleLength
@assert vr.weapon.anchor gt {daggerHandle*0.49}
@assert vr.weapon.anchor lt {daggerHandle*0.51}
@assert vr.weapon.hiltToGrip lt 0.5
@assert vr.weapon.edgeToKnuckles lt 5
@shot dagger

# An axe: near the handle's end
inventory playeraddfromscene axe_9001
axe_9001.equip player
@until vr.weapon.item eq axe_9001 5s
@frames 15
@assert vr.weapon.frame eq glove
@assert vr.weapon.weaponClass eq axe
@remember axeHandle vr.weapon.handleLength
@assert vr.weapon.anchor ge {axeHandle*0.15}
@assert vr.weapon.anchor le {axeHandle*0.25}
@assert vr.weapon.hiltToGrip lt 0.5
@assert vr.weapon.edgeToKnuckles lt 5
@shot axe

# A mace (the club): near the handle's end
inventory playeraddfromscene club_9001
club_9001.equip player
@until vr.weapon.item eq club_9001 5s
@frames 15
@assert vr.weapon.frame eq glove
@assert vr.weapon.weaponClass eq mace
@remember maceHandle vr.weapon.handleLength
@assert vr.weapon.anchor ge {maceHandle*0.15}
@assert vr.weapon.anchor le {maceHandle*0.25}
@assert vr.weapon.hiltToGrip lt 0.5
@shot mace

# A two-handed sword in the right hand: a hand-width above the pommel
inventory playeraddfromscene sword_2handed_9001
sword_2handed_9001.equip player
@until vr.weapon.item eq sword_2handed_9001 5s
@frames 15
@assert vr.weapon.frame eq glove
@assert vr.weapon.weaponClass eq twoHanded
@assert vr.weapon.handWidth gt 5
@remember width vr.weapon.handWidth
@remember twoHandle vr.weapon.handleLength
@assert vr.weapon.anchor le {twoHandle}
@assert vr.weapon.anchor gt {width-0.1}
@assert vr.weapon.anchor lt {width+0.1}
@assert vr.weapon.hiltToGrip lt 0.5
@assert vr.weapon.edgeToKnuckles lt 5
@shot two-handed

@assert errors eq 0
